# Discord Developer Portal에서 발급받은 Application 정보
# https://discord.com/developers/applications

# 일반 정보 (General Information)의 Application ID (Client ID)
VITE_DISCORD_CLIENT_ID=

# OAuth2 탭에서 발급받은 Client Secret (서버 미들웨어에서만 사용되며 브라우저에 노출되지 않음)
DISCORD_CLIENT_SECRET=

# 리다이렉트 URI (기본값: http://localhost:5173)
VITE_DISCORD_REDIRECT_URI=http://localhost:5173
