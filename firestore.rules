rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // users 컬렉션
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (!("currentStreak" in request.resource.data) || (request.resource.data.currentStreak >= 0 && request.resource.data.currentStreak <= 10000))
                   && (!("totalLongestStreak" in request.resource.data) || (request.resource.data.totalLongestStreak >= 0 && request.resource.data.totalLongestStreak <= 10000))
                   && (!("totalPlayCount" in request.resource.data) || (request.resource.data.totalPlayCount >= 0 && request.resource.data.totalPlayCount <= 1000000));
    }
    
    // 리더보드 점수 컬렉션 (scores_YYYY-MM-DD)
    match /leaderboard/{dailySeed}/scores/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.deviceId == request.auth.uid
                   && request.resource.data.time >= 2.0
                   && request.resource.data.mistakes >= 0;
    }
  }
}
