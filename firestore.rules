rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 모든 쓰기는 Worker가 서비스 계정 권한으로 처리한다 (Discord/Firebase 토큰으로 본인 확인,
    // 입력 기록 재생으로 점수 검증). 클라이언트 SDK의 직접 쓰기는 허용하지 않는다.

    // users 컬렉션: 프로필은 공개 읽기 (Discord ID로 기록 복원 시 조회)
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 리더보드 점수 컬렉션 (leaderboard/YYYYMMDD/scores)
    match /leaderboard/{dailySeed}/scores/{scoreId} {
      allow read: if true;
      allow write: if false;
    }

    // 멀티플레이 결과 로그 컬렉션 (읽기/쓰기 모두 서버 전용)
    match /multiplayer_logs/{logId} {
      allow read, write: if false;
    }
  }
}
